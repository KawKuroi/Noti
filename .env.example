# =============================================================================
# NOTI — Variables de entorno
# =============================================================================
# Copia este archivo como .env.local y completa los valores reales.
# NUNCA subas .env.local al repositorio.
# Las variables con prefijo NEXT_PUBLIC_ son visibles en el navegador.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (Postgres de Supabase, via Drizzle ORM)
#
# Hay dos formas de conectar:
#
# 1) Conexion directa (puerto 5432) - para desarrollo local
#    Host: db.<project-ref>.supabase.co:5432
#    Obtener en: Supabase Dashboard -> Settings -> Database -> Connection string
#    OJO: este host es solo IPv6. Vercel (y otros serverless IPv4-only)
#    fallan con ENOTFOUND. NO usar en produccion.
#    Formato: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
#
# 2) Connection Pooler / Supavisor (puerto 6543, transaction mode) - para Vercel
#    Host: aws-0-<region>.pooler.supabase.com:6543
#    Obtener en: Supabase Dashboard -> Settings -> Database -> Connection pooling
#    Compatible con IPv4 y disenado para serverless.
#    El usuario tiene el formato postgres.<project-ref> (no solo postgres).
#    Formato: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# -----------------------------------------------------------------------------

DATABASE_URL=

# -----------------------------------------------------------------------------
# Supabase
# Obtener en: https://app.supabase.com → Proyecto → Settings → API
# -----------------------------------------------------------------------------

# URL del proyecto Supabase (publica por diseno de Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-ref.supabase.co

# Clave anonima de Supabase (publica, segura con RLS activo)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de rol de servicio (PRIVADA — solo en servidor, bypasea RLS)
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Web Push — VAPID Keys
# Generar con: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------

# Clave publica VAPID (se envia al navegador para suscribirse)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Clave privada VAPID (PRIVADA — solo en servidor para firmar envios)
VAPID_PRIVATE_KEY=

# Email de contacto requerido por el protocolo VAPID (formato mailto:)
VAPID_EMAIL=mailto:tu@email.com

# -----------------------------------------------------------------------------
# TMDB — The Movie Database API (peliculas y series)
# Obtener en: https://www.themoviedb.org/settings/api
# Plan gratuito: 40 peticiones cada 10 segundos
# -----------------------------------------------------------------------------

# Clave de API de TMDB (PRIVADA — se usa solo en servidor)
TMDB_API_KEY=

# URL base de la API de TMDB
TMDB_API_BASE_URL=https://api.themoviedb.org/3

# -----------------------------------------------------------------------------
# RAWG — API de videojuegos
# Obtener en: https://rawg.io/apidocs
# Plan gratuito: 20.000 peticiones al mes
# -----------------------------------------------------------------------------

# Clave de API de RAWG (PRIVADA — se usa solo en servidor)
RAWG_API_KEY=

# -----------------------------------------------------------------------------
# MusicBrainz — API de albumes y musica
# NO requiere API key, pero exige User-Agent identificable.
# Documentacion: https://musicbrainz.org/doc/MusicBrainz_API
# Rate limit: 1 peticion por segundo.
# -----------------------------------------------------------------------------

# (sin variables — configurado en el servicio)

# -----------------------------------------------------------------------------
# Groq — Chat IA de lanzamientos y asistente de recordatorios
# Obtener en: https://console.groq.com (free tier sin tarjeta)
# Plan gratuito: 30 RPM, hasta 14.400 req/dia segun modelo
# -----------------------------------------------------------------------------

# Clave de API de Groq (PRIVADA — solo servidor)
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# Aplicacion
# -----------------------------------------------------------------------------

# URL publica de la app (sin barra final)
# Desarrollo local: http://localhost:3000
# Produccion: https://noti.vercel.app (o tu dominio custom)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Seguridad de Cron
# Protege el endpoint /api/cron/check-reminders de llamadas no autorizadas.
# Generar con: openssl rand -base64 32
# Configurar el mismo valor en Vercel → Settings → Environment Variables
# -----------------------------------------------------------------------------

CRON_SECRET=

# -----------------------------------------------------------------------------
# Vercel Blob — almacenamiento de adjuntos en notas (imagenes, audios, docs, videos)
# Obtener en: Vercel Dashboard → Storage → Blob → Create Store → obtener token
# Plan gratuito (Hobby): 500 MB storage, 5 GB bandwidth/mes
# Generar con el CLI: vercel blob token create
# -----------------------------------------------------------------------------

BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# Resend — envio de correos (formulario de sugerencias)
# Obtener en: https://resend.com (free tier: 3000 emails/mes, sin tarjeta)
# Crear API key en: Resend Dashboard → API Keys → Create API Key
# -----------------------------------------------------------------------------

RESEND_API_KEY=re_...

# Email destinatario del formulario de sugerencias de la landing page
CONTACT_DESTINATION_EMAIL=tu@email.com

# -----------------------------------------------------------------------------
# Google OAuth (solo para desarrollo local con Supabase CLI)
# Configurar en: https://console.cloud.google.com → APIs → Credenciales
# En produccion, configurar directamente en el dashboard de Supabase Auth
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# MCP servers (solo para desarrollo asistido con Claude Code)
# =============================================================================
# El proyecto incluye `.mcp.json` con dos MCP servers de scope project:
#   - supabase        → inspeccion read-only de la DB, auth, logs y RLS
#   - chrome-devtools → verificacion de PWA, service worker, push y Lighthouse
#
# El `project-ref` de Supabase va literal en `.mcp.json` (no es secreto).
# El Personal Access Token (PAT) NO se commitea: se referencia como
# `${SUPABASE_ACCESS_TOKEN}` y debe existir como variable de entorno del
# sistema antes de lanzar Claude Code.
#
# Pasos para activarlos:
#
#   1. Generar PAT en: https://supabase.com/dashboard/account/tokens
#      (nombre sugerido: "Claude Code MCP - Noti")
#
#   2. Persistirlo como variable de usuario en Windows:
#        setx SUPABASE_ACCESS_TOKEN "sbp_xxxxxxxxxxxx"
#      Equivalente en macOS/Linux: agregar a ~/.zshrc o ~/.bashrc:
#        export SUPABASE_ACCESS_TOKEN="sbp_xxxxxxxxxxxx"
#
#   3. Cerrar y reabrir la terminal/Claude Code para que la variable cargue.
#
#   4. Aprobar la confianza del `.mcp.json` la primera vez que abras Claude.
#
# Verificacion: `claude mcp list` debe mostrar ambos como `connected`.
#
# NOTA: el PAT da acceso a toda tu cuenta de Supabase. Por eso el MCP corre
# con `--read-only` y `--project-ref` para limitar el blast radius al proyecto
# de Noti.
# -----------------------------------------------------------------------------

# (no agregar SUPABASE_ACCESS_TOKEN aqui — debe ser variable del sistema)
