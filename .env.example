# =============================================================================
# NOTI — Variables de entorno
# =============================================================================
# Copia este archivo como .env.local y completa los valores reales.
# NUNCA subas .env.local al repositorio.
# Las variables con prefijo NEXT_PUBLIC_ son visibles en el navegador.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (conexion directa para Drizzle ORM)
# Obtener en: Supabase Dashboard → Settings → Database → Connection string → URI
# Formato: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# -----------------------------------------------------------------------------

DATABASE_URL=

# -----------------------------------------------------------------------------
# Supabase
# Obtener en: https://app.supabase.com → Proyecto → Settings → API
# -----------------------------------------------------------------------------

# URL del proyecto Supabase (publica por diseno de Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-ref.supabase.co

# Clave anonima de Supabase (publica, segura con RLS activo)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de rol de servicio (PRIVADA — solo en servidor, bypasea RLS)
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Web Push — VAPID Keys
# Generar con: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------

# Clave publica VAPID (se envia al navegador para suscribirse)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Clave privada VAPID (PRIVADA — solo en servidor para firmar envios)
VAPID_PRIVATE_KEY=

# Email de contacto requerido por el protocolo VAPID (formato mailto:)
VAPID_EMAIL=mailto:tu@email.com

# -----------------------------------------------------------------------------
# TMDB — The Movie Database API
# Obtener en: https://www.themoviedb.org/settings/api
# Plan gratuito: 40 peticiones cada 10 segundos
# -----------------------------------------------------------------------------

# Clave de API de TMDB (PRIVADA — se usa solo en servidor como proxy)
TMDB_API_KEY=

# URL base de la API de TMDB
TMDB_API_BASE_URL=https://api.themoviedb.org/3

# -----------------------------------------------------------------------------
# Aplicacion
# -----------------------------------------------------------------------------

# URL publica de la app (sin barra final)
# Desarrollo local: http://localhost:3000
# Produccion: https://noti.vercel.app (o tu dominio custom)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Seguridad de Cron
# Protege el endpoint /api/cron/check-reminders de llamadas no autorizadas.
# Generar con: openssl rand -base64 32
# Configurar el mismo valor en Vercel → Settings → Environment Variables
# -----------------------------------------------------------------------------

CRON_SECRET=

# -----------------------------------------------------------------------------
# Google OAuth (solo para desarrollo local con Supabase CLI)
# Configurar en: https://console.cloud.google.com → APIs → Credenciales
# En produccion, configurar directamente en el dashboard de Supabase Auth
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
